doctype html
html
  head
    link(rel="stylesheet" href="https://unpkg.com/sakura.css/css/sakura.css")
    style.
      body { background: white; max-width: 50em; }
      .keep-together { page-break-inside: avoid; }
      @page { size: A4; margin: 0.5in; }
      @media print {
        body { max-width: 50em; margin: auto; padding: 13px; font-size: 1.1rem; line-height: 1.45; color: #4a4a4a; background: white; }
        h1 { font-size: 2.35em; margin-top: 0; margin-bottom: 1rem; }
        h2 { font-size: 2em; margin-top: 1.5rem; margin-bottom: 0.75rem; }
        h3 { font-size: 1.75em; margin-top: 1.25rem; margin-bottom: 0.5rem; }
        h4 { font-size: 1.5em; margin-top: 1rem; margin-bottom: 0.5rem; }
        p { margin-bottom: 1rem; }
        ul { margin-bottom: 1rem; }
        li { margin-bottom: 0.2em; }
        a { color: #1d7484; }
        .keep-together { break-inside: avoid; page-break-inside: avoid; }
      }
