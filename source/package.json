{
  "name": "coverslide.me",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "npm run build-html && npm run build-css && npm run build-public && npm run build-js && npm run build-resume",
    "build-js": "esbuild src/index.js --bundle --format=iife --target=es2017 --outfile=build/index.js",
    "build-css": "postcss styles/index.scss -o build/style.css",
    "build-html": "node scripts/build-html.js",
    "build-resume": "node scripts/build-resume.js",
    "build-pdf": "node scripts/html-to-pdf.js ../resume.html ../resume.pdf",
    "build-public": "cp -r public/* build/",
    "pages": "npm run build && cp -r build/* ../"
  },
  "repository": {
    "type": "git",
    "url": "ssh://git-codecommit.us-west-2.amazonaws.com/v1/repos/coverslide.me"
  },
  "private": true,
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "autoprefixer": "^10.4.4",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.28",
    "postcss-cli": "^11.0.1",
    "postcss-nested": "^7.0.2",
    "pug": "^3.0.4",
    "raf": "^3.4.1"
  }
}
